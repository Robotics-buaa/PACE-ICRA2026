#usda 1.0
(
    defaultPrim = "G1"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "G1" (
    instanceable = false
    prepend references = @/workspace/projects/PACE-ICRA2026/legged_lab/assets/unitree/G1_TT/G1_TT.usda@
)
{
    over "right_elbow_roll_link"
    {
        def PhysicsRevoluteJoint "right_palm_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 0.017453292
            float drive:angular:physics:maxForce = 8
            float drive:angular:physics:stiffness = 0.34906584
            float drive:angular:physics:targetPosition = 0
            float drive:angular:physics:targetVelocity = 0
            uniform token drive:angular:physics:type = "force"
            uniform token physics:axis = "Z"
            rel physics:body0 = </G1/right_elbow_roll_link>
            rel physics:body1 = </G1/right_palm_link>
            bool physics:collisionEnabled = 0
            uniform bool physics:excludeFromArticulation = 0
            bool physics:jointEnabled = 1
            point3f physics:localPos0 = (0.12, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -90
            float physics:upperLimit = 90
        }
    }
}

